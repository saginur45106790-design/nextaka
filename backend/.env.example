# Copy to backend/.env for LOCAL development. Never commit real .env files.
NODE_ENV=development
PORT=3001
DATABASE_URL=
FRONTEND_URL=http://localhost:5173
# Generate TWO DIFFERENT secrets, each with: openssl rand -hex 32
SESSION_SECRET=
IP_HASH_SECRET=

# HTTPS email integration: Resend. Requires an authorized verified sender.
EMAIL_API_KEY=
EMAIL_FROM=
# SUPPORT_EMAIL=your-monitored-mailbox@example.com

# Public site key + private server key from the same Turnstile widget.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=localhost
DISPOSABLE_EMAIL_DOMAINS=mailinator.com,guerrillamail.com,tempmail.com,10minutemail.com
TRUST_PROXY_HOPS=0
# Allowed only with NODE_ENV=test. NEVER enable in deployed environments.
AUTH_TEST_BYPASS=false

# PRE-LAUNCH. All four flags AND database launch approvals are required.
# Free Render infrastructure must keep every flag false.
FINANCIAL_ACTIVITY_ENABLED=false
DURABLE_INFRASTRUCTURE_CONFIRMED=false
COMPLIANCE_APPROVED=false
PAYMENT_OPERATIONS_READY=false

# Separate owner URL for migrations on paid production (runtime uses least privilege).
MIGRATION_DATABASE_URL=
BACKUPS_RESTORE_TESTED=false
SECURITY_REVIEW_APPROVED=false
